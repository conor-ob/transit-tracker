{
  "name": "transit-tracker",
  "private": true,
  "description": "Transit Tracker API deployment for Irish public transport on Railway",
  "type": "module",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.15.0",
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "railway": "^3.16.0",
    "turbo": "^2.11.5",
    "typescript": "catalog:"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "compose:up": "docker compose up -d",
    "compose:down": "docker compose down",
    "compose:sync": "docker compose run --rm transit-tracker-api \"pnpm gtfs:db:migrate && node ./dist/cli sync\""
  },
  "engines": {
    "node": ">=24.19.0"
  }
}
