{
  "name": "transit-tracker",
  "private": true,
  "description": "Transit Tracker API deployment for Irish public transport on Railway",
  "type": "module",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.15.0",
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "railway": "^3.16.0",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc && tsc -p apps/schedule-proxy",
    "compose:up": "docker compose up -d",
    "compose:down": "docker compose down",
    "compose:sync": "docker compose run --rm api \"pnpm gtfs:db:migrate && node ./dist/cli sync\"",
    "test": "pnpm --filter schedule-proxy test"
  },
  "engines": {
    "node": ">=24.19.0"
  }
}
