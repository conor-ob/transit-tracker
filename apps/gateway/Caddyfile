# global options
{
	admin off # theres no need for the admin api in railway's environment
	persist_config off # storage isn't persistent anyway
	auto_https off # railway handles https for us, this would cause issues if left enabled
	log {
		format json
	}
	servers {
		trusted_proxies static private_ranges # trust railway's proxy
	}
}

# listens on the $PORT environment variable
:{$PORT} {
	log {
		format json
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Content-Security-Policy "frame-ancestors 'none'"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	encode zstd gzip

	# websocket upgrades (what devices use) and the rest schedule go through
	# the schedule proxy, which applies direction filters
	@schedule expression header({'Upgrade': 'websocket'}) || path('/schedule/*')

	handle @schedule {
		reverse_proxy {$SCHEDULE_PROXY_URL} {
			header_up Host {upstream_hostport}
		}
	}

	# proxy everything else to the api over private networking
	handle {
		reverse_proxy {$API_URL} {
			header_up Host {upstream_hostport}
		}
	}
}
